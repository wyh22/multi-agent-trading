# LLM
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.5
TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tradingagents-a-share

# Agent workflow
TRADINGAGENTS_STRICT_ASOF=true
TRADINGAGENTS_ANALYST_CONCURRENCY=3
TRADINGAGENTS_MAX_AUDIT_ROUNDS=2

# MCP (Docker Compose overrides these URLs automatically)
TRADINGAGENTS_MCP_ENABLED=false
TRADINGAGENTS_MCP_URL=http://localhost:8001/mcp
TRADINGAGENTS_MCP_FALLBACK_TO_LOCAL=true
# Optional extra MCP servers for the conversational layer only.
TRADINGAGENTS_EXTERNAL_MCP_ENABLED=false
# TRADINGAGENTS_EXTERNAL_MCP_SERVERS_JSON={"external":{"transport":"http","url":"http://host.docker.internal:9000/mcp"}}
# Comma-separated read-only tools; empty means no external tools are exposed to the LLM.
TRADINGAGENTS_EXTERNAL_MCP_TOOL_ALLOWLIST=

# PIT-aware RAG / Qdrant
TRADINGAGENTS_RAG_ENABLED=false
TRADINGAGENTS_QDRANT_URL=http://localhost:6333
TRADINGAGENTS_QDRANT_COLLECTION=a_share_knowledge
TRADINGAGENTS_RAG_EMBEDDING_BACKEND=fastembed
TRADINGAGENTS_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
TRADINGAGENTS_RAG_RERANKER_ENABLED=true
TRADINGAGENTS_RAG_RERANKER_MODEL=BAAI/bge-reranker-base

# Multi-turn conversation
# TRADINGAGENTS_CONVERSATION_DB_PATH=~/.tradingagents/conversation/conversation.db
TRADINGAGENTS_CONVERSATION_HISTORY_TURNS=12
TRADINGAGENTS_CONVERSATION_TOOL_ROUNDS=4

